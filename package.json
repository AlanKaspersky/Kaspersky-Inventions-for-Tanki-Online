{
  "name": "Kaspersky's Inventions",
  "version": "3.0.2",
  "description": "Interface tools for Tanki Online: battle history, augment stats, quick upgrades, privacy controls and lobby customization.",
  "private": true,
  "scripts": {
    "test": "node tools/run-tests.cjs",
    "test:browser:settings": "node tools/browser/settings.cjs",
    "test:browser:weather": "node tools/browser/rain-weather-browser.cjs",
    "test:browser:trophies": "node tools/browser/custom-trophies-browser.cjs",
    "test:client": "node tools/run-tests.cjs client",
    "check": "npm run typecheck && npm test",
    "typecheck": "tsc --noEmit",
    "parse:client": "node tools/parser/client-parser.cjs",
    "prepare:overdrive": "node tools/prepare/prepare-overdrive.cjs",
    "prepare:arcade": "node tools/prepare/prepare-arcade.cjs",
    "build:js": "esbuild src/kasp_main.ts src/kasp_injector.ts --bundle --format=iife --target=chrome100 --outdir=dist",
    "build:zip": "npm run check && node tools/build/build-release.js",
    "build": "npm run check && npm run build:js && node tools/build/build-release.js",
    "release": "npm run build",
    "watch": "esbuild src/kasp_main.ts src/kasp_injector.ts --bundle --format=iife --target=chrome100 --outdir=dist --watch",
    "prepare:augments": "node tools/prepare/prepare-augments.cjs",
    "prepare:garage-details": "node tools/prepare/prepare-garage-details.cjs",
    "prepare:garage-items": "node tools/prepare/prepare-garage-items.cjs",
    "prepare:garage-inventory": "node tools/prepare/prepare-garage-inventory.cjs",
    "prepare:battle-presence": "node tools/prepare/prepare-battle-presence.cjs",
    "prepare:battle-statistics": "node tools/prepare/prepare-battle-statistics.cjs",
    "prepare:user-action": "node tools/prepare/prepare-user-action.cjs",
    "prepare:critical": "node tools/prepare/prepare-critical.cjs",
    "prepare:supply-privacy": "node tools/prepare/prepare-supply-privacy.cjs",
    "prepare:box-pickup": "node tools/prepare/prepare-box-pickup.cjs",
    "prepare:kill-feed-privacy": "node tools/prepare/prepare-kill-feed-privacy.cjs",
    "prepare:rain-weather": "node tools/prepare/prepare-rain-weather.cjs"
  },
  "author": "Alan Kaspersky",
  "license": "UNLICENSED",
  "type": "commonjs",
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "astring": "^1.9.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
