{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "rootDir": "./src", 
    "outDir": "./dist",
    "strict": false,
    "skipLibCheck": true,
    "sourceMap": false,
    "declaration": false,
    "declarationMap": false,
    "removeComments": true,
    "forceConsistentCasingInFileNames": true
  },
  "exclude": ["node_modules", "archived"]
}