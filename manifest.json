{
  "manifest_version": 3,
  "name": "Kaspersky's Inventions",
  "version": "1.9",
  "default_locale": "en",
  "description": "__MSG_extensionDescription__",
  "icons": {
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.tankionline.com/*", "*://tankionline.com/*"],
      "css": ["styles/mainUI.css"],
      "js": ["dist/kasp_injector.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.tankionline.com/*"],
      "js": ["dist/kasp_main.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/medals/*.png"],
      "matches": ["*://*.tankionline.com/*"]
    }
  ]
}